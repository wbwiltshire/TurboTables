{
    "name": "turbotables",
    "version": "1.0.0",
    "description": "Paging, sorting, searching and filtering for HTML tables (Bootstrap 5) - library and demo app",
    "private": true,
    "main": "app.js",
    "author": {
        "name": "wbwiltshire"
    },
    "license": "Apache-2.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "node ./app.js",
        "dev": "node --env-file=dev.env --watch ./app.js",
        "build": "node ./scripts/build.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "update": "npx npm-check-updates --interactive"
    },
    "dependencies": {
        "express": "5.3.0",
        "hbs": "4.4.0",
        "morgan": "1.12.1"
    },
    "devDependencies": {
        "esbuild": "0.28.2",
        "jsdom": "31.0.1",
        "vitest": "5.1.2"
    }
}
