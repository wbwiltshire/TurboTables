<div class="page-header">
     <h1>{{title}}</h1>
</div>
<div class="d-flex gap-2 mb-3">
     <a id="add" class="btn btn-primary" href="/customer/add"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add</a>
     <a id="refresh" class="btn btn-primary" href="#"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Refresh</a>
</div>
<p class="text-body-secondary">A plain table without TurboTables, for comparison. See <a href="/pager">Customers</a> for paging, sorting and filtering.</p>
<div id="spinner" class="page-spinner" role="status" hidden>
     <div class="spinner-border text-primary"><span class="visually-hidden">Loading...</span></div>
</div>
<div class="card">
     <div class="card-body">
          <table id="ajaxGrid" class="table table-hover table-sm mb-0">
               <thead>
                    <tr>
                         <th>Id</th>
                         <th>First Name</th>
                         <th>Last Name</th>
                         <th>E-Mail</th>
                    </tr>
               </thead>
               <tbody id="CustomerList">
                    {{#each customers.customers}}
                    <tr>
                         <td><a href="/customer/{{Id}}">{{Id}}</a></td>
                         <td>{{FirstName}}</td>
                         <td>{{LastName}}</td>
                         <td>{{EMail}}</td>
                    </tr>
                    {{/each}}
               </tbody>
          </table>
     </div>
</div>
<script id="customerListHGrid" type="text/x-handlebars-template">
     \{{#each CustomerList}}
     <tr>
          <td><a href="/customer/\{{Id}}">\{{Id}}</a></td>
          <td>\{{FirstName}}</td>
          <td>\{{LastName}}</td>
          <td>\{{EMail}}</td>
     </tr>
     \{{/each}}
</script>
{{#contentFor 'pageScripts'}}
<script src="https://cdn.jsdelivr.net/npm/handlebars@4.7.10/dist/handlebars.min.js" integrity="sha384-SoqWttrT0kCFnwAKU794AqlRj1nmM9VO+d76IkRVSwyEFTiq76rJQ72pG+gbRO7e" crossorigin="anonymous"></script>
<script src="/javascripts/ajaxcommon.js"></script>
<script src="/javascripts/customer.js"></script>
{{/contentFor}}
