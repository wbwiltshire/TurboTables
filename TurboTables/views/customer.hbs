<h1>{{title}}</h1>
<div class="row mb-3">
     <div class="col-md-12">
          <a id="add" class="btn btn-primary" href="/customer/add">Add</a>
          <a id="refresh" class="btn btn-primary" href="#">Refresh</a>
     </div>
</div>
<div id="spinner" class="tt-spinner" role="status" hidden>
     <img src="/images/spinner-128.gif" alt="Loading..." />
</div>
<div class="row">
     <div class="col-md-12">
          <table id="ajaxGrid" class="table table-striped table-bordered table-hover table-sm">
               <thead>
                    <tr>
                         <th>ID</th>
                         <th>First Name</th>
                         <th>Last Name</th>
                         <th>E-Mail</th>
                    </tr>
               </thead>
               <tbody id="CustomerList">
                    {{#each customers.customers}}
                    <tr>
                         <td><a href="/customer/{{Id}}">{{Id}}</a></td>
                         <td>{{FirstName}}</td>
                         <td>{{LastName}}</td>
                         <td>{{EMail}}</td>
                    </tr>
                    {{/each}}
               </tbody>
          </table>
     </div>
</div>
<div class="row mt-3">
     <div class="col-lg-4">
          <a href="/" class="btn btn-primary">Back</a>
     </div>
</div>
<script id="customerListHGrid" type="text/x-handlebars-template">
     \{{#each CustomerList}}
     <tr>
          <td><a href="/customer/\{{Id}}">\{{Id}}</a></td>
          <td>\{{FirstName}}</td>
          <td>\{{LastName}}</td>
          <td>\{{EMail}}</td>
     </tr>
     \{{/each}}
</script>
{{#contentFor 'pageScripts'}}
<script src="https://cdn.jsdelivr.net/npm/handlebars@4.7.10/dist/handlebars.min.js" integrity="sha384-SoqWttrT0kCFnwAKU794AqlRj1nmM9VO+d76IkRVSwyEFTiq76rJQ72pG+gbRO7e" crossorigin="anonymous"></script>
<script src="/javascripts/ajaxcommon.js"></script>
<script src="/javascripts/customer.js"></script>
{{/contentFor}}
