<div class="page-header">
     <h1>{{title}}</h1>
     <a href="/pager" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to customers</a>
</div>
<div class="card col-lg-6">
     <div class="card-body">
          {{#with customer}}
          <dl class="row mb-0">
               <dt class="col-sm-4 text-body-secondary fw-normal">Id</dt>
               <dd class="col-sm-8">{{Id}}</dd>
               <dt class="col-sm-4 text-body-secondary fw-normal">First name</dt>
               <dd class="col-sm-8">{{FirstName}}</dd>
               <dt class="col-sm-4 text-body-secondary fw-normal">Last name</dt>
               <dd class="col-sm-8">{{LastName}}</dd>
               <dt class="col-sm-4 text-body-secondary fw-normal">E-mail</dt>
               <dd class="col-sm-8 mb-0">{{EMail}}</dd>
          </dl>
          {{/with}}
     </div>
</div>
