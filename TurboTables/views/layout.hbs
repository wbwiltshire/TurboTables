<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <title>{{title}} - TurboTables</title>
     <script src="/javascripts/themeswitcher.js"></script>
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" integrity="sha384-yEPZ7jP9S0QKiUQ0m3jjsO4ProIW7wvR9gXkI7JOGa2XVsw53Yke2bsdkBbjmmiX" crossorigin="anonymous" />
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@7.3.1/css/all.min.css" integrity="sha384-qrALq7+6jBOZIQsNnT6xGkMDru64qD6uTlDra39xrt2SoXl4pO3FX6Roz/RpR/BS" crossorigin="anonymous" />
     <link rel="stylesheet" href="/stylesheets/turbotables.css" />
     <link rel="stylesheet" href="/stylesheets/site.css" />
</head>
<body>
     <nav class="navbar navbar-expand-lg bg-body border-bottom shadow-sm">
          <div class="container">
               <a href="/" class="navbar-brand fw-semibold">
                    <i class="fa-solid fa-table-list text-primary me-2" aria-hidden="true"></i>TurboTables
               </a>
               <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                       aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
               </button>
               <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto">
                         <li class="nav-item"><a class="nav-link" href="/pager">Customers</a></li>
                         <li class="nav-item"><a class="nav-link" href="/customer">Simple list</a></li>
                         <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                    </ul>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="theme-toggle" aria-label="Switch theme">
                         <i class="fa-solid fa-moon" aria-hidden="true"></i> <span>Dark</span>
                    </button>
               </div>
          </div>
     </nav>
     <main class="container py-4">
          {{{body}}}
     </main>
     <footer class="container pb-4 small text-body-secondary text-center">
          &copy; {{year}} Seagull Consulting &middot; TurboTables v{{version}}
     </footer>
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js" integrity="sha384-WyOxWvTyr1QaMPfiPJSv76iReVthorl5uWlFtZPyK0IEB0hGzo9y5Bp9mYanr8Bu" crossorigin="anonymous"></script>
     {{{block 'pageScripts'}}}
</body>
</html>
