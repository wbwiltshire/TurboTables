{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Turbo Tables",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}/TurboTables",
            "program": "${workspaceFolder}/TurboTables/app.js",
            // Development settings (NODE_ENV, PORT, DEMO_DELAY_MS) come from TurboTables/dev.env
            "runtimeArgs": ["--env-file=dev.env"],
            "console": "integratedTerminal"
        }
    ]
}
